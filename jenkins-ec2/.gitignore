# Local .terraform directories

.terraform/

# Terraform state files

*.tfstate
*.tfstate.*

# Crash log files

crash.log

# Exclude all .tfvars files (they often contain secrets)

*.tfvars
*.tfvars.json

# Ignore override files

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files

.terraformrc
terraform.rc

# Ignore plan output files

*.tfplan

# Ignore lock file (optional - usually keep it)

# .terraform.lock.hcl

# Ignore sensitive variable files

secrets.auto.tfvars

# macOS / Linux / Windows junk

.DS_Store
Thumbs.db
